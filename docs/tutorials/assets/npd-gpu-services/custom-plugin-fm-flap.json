{
  "plugin": "custom",
  "pluginConfig": {
    "invoke_interval": "30s",
    "timeout": "15s",
    "max_output_length": 120,
    "skip_initial_status": true
  },
  "source": "nvsentinel-gpu-services-fm-flap",
  "metricsReporting": false,
  "conditions": [
    {
      "type": "FabricManagerFlapping",
      "reason": "FabricManagerStable",
      "message": "nvidia-fabricmanager restart rate is normal"
    }
  ],
  "rules": [
    {
      "type": "permanent",
      "condition": "FabricManagerFlapping",
      "reason": "FabricManagerFlapping",
      "path": "/etc/npd-plugins/check_fm_flapping.sh",
      "timeout": "12s"
    }
  ]
}
