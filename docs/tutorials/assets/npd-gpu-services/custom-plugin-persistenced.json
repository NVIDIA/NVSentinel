{
  "plugin": "custom",
  "pluginConfig": {
    "invoke_interval": "30s",
    "timeout": "15s",
    "max_output_length": 120,
    "skip_initial_status": true
  },
  "source": "nvsentinel-gpu-services-persistenced",
  "metricsReporting": false,
  "conditions": [
    {
      "type": "NvidiaPersistencedDown",
      "reason": "NvidiaPersistencedActive",
      "message": "nvidia-persistenced is active"
    }
  ],
  "rules": [
    {
      "type": "permanent",
      "condition": "NvidiaPersistencedDown",
      "reason": "NvidiaPersistencedNotActive",
      "path": "/etc/npd-plugins/check_gpu_service.sh",
      "args": [
        "nvidia-persistenced"
      ],
      "timeout": "12s"
    }
  ]
}
